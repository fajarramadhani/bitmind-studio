# Current production candidate. Override once the primary domain changes.
NEXT_PUBLIC_SITE_URL=https://bitmindstudio.web.id

# Explicit content mode: local or supabase.
CONTENT_SOURCE=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Preferred for the current Supabase/Vercel integration. Server-only; never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy and backwards-compatible. Server-only; never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
